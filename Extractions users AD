$csvPath = "C:\Temp\ListeUtilisateurs_Progisap.csv"

# Lecture du fichier CSV
$users = Import-Csv -Path $csvPath

# Liste pour stocker les résultats
$results = @()

foreach ($user in $users) {
    if ($user.Mail) {
        $escapedMail = $user.Mail.Replace("'", "''")

        try {
            $adUser = Get-ADUser -Filter "Mail -eq '$escapedMail'" -Properties `
                EmailAddress, DisplayName, Mail, SamAccountName, Enabled, Description, `
                Company, Office, WhenCreated, WhenChanged, LastLogonDate
        } catch {
            Write-Warning "❌ Erreur lors de la récupération de l'utilisateur avec le mail : $($user.Mail)"
            continue
        }

        if ($adUser) {
            $results += [PSCustomObject]@{
                EmailAddress   = $adUser.EmailAddress
                DisplayName    = $adUser.DisplayName
                Mail           = $adUser.Mail
                SamAccountName = $adUser.SamAccountName
                Enabled        = $adUser.Enabled
                Description    = $adUser.Description
                Company        = $adUser.Company
                Office         = $adUser.Office
                WhenCreated    = $adUser.WhenCreated
                WhenChanged    = $adUser.WhenChanged
                LastLogonDate  = $adUser.LastLogonDate
            }
        } else {
            Write-Warning "⚠️ Utilisateur non trouvé avec l'adresse : $($user.Mail)"
        }
    } else {
        Write-Warning "⚠️ Mail vide pour l'utilisateur : $($user.DisplayName)"
    }
}

# Exporter les résultats
$results | Export-Csv -Path "C:\Temp\ResultatsUtilisateurs_AD.csv" -NoTypeInformation -Encoding UTF8



# Chemins des fichiers
$InputPath = "C:\Temp\SamUtilisateur.csv"
$OutputPath = "C:\Temp\ListeUtilisateursAD_filtrés.csv"

# Importer la liste des SamAccountName
$entries = Import-Csv -Path $InputPath
$UserList = @()

# Parcourir chaque ligne du fichier
foreach ($entry in $entries) {
    if ($entry.SamAccountName) {
        try {
            $user = Get-ADUser -Identity $entry.SamAccountName -Properties SamAccountName, Name, whenCreated, whenChanged, Enabled, AccountExpirationDate, LastLogonDate

            $UserList += [PSCustomObject]@{
                "Identifiant"            = $user.SamAccountName
                "Nom d'utilisateur"      = $user.Name
                "Date de création"       = $user.whenCreated
                "Dernière mise à jour"   = $user.whenChanged
                "Statut"                 = if ($user.Enabled) { "Actif" } else { "Non actif" }
                "Date de désactivation"  = if ($user.AccountExpirationDate) { $user.AccountExpirationDate } else { "N/A" }
                "Dernière connexion"     = if ($user.LastLogonDate) { $user.LastLogonDate } else { "Jamais connecté" }
            }
        } catch {
            Write-Warning "❌ Utilisateur introuvable : $($entry.SamAccountName)"
        }
    } else {
        Write-Warning "⚠️ Ligne vide ou sans identifiant dans le CSV."
    }
}

# Exporter le résultat
$UserList | Export-Csv -Path $OutputPath -NoTypeInformation -Encoding UTF8

# Afficher les résultats dans la console
$UserList
